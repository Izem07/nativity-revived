# Primary Gemini API Key (get free at https://aistudio.google.com/app/apikey)
VITE_GEMINI_API_KEY=your_api_key_here

# Optional: Add multiple keys for automatic round-robin rotation
# When one key hits quota/rate limits, the pool auto-rotates to the next
VITE_GEMINI_API_KEY_1=your_first_key_here
VITE_GEMINI_API_KEY_2=your_second_key_here
VITE_GEMINI_API_KEY_3=your_third_key_here
